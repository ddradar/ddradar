{
  "name": "ddradar",
  "version": "3.0.0",
  "description": "DDR Score Tracker",
  "repository": "https://github.com/ddradar/ddradar.git",
  "author": "Nogic <24802730+nogic1008@users.noreply.github.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' nuxt build",
    "db:generate": "nuxt db generate",
    "db:query": "wrangler d1 execute DB",
    "dev": "nuxt dev",
    "fix": "pnpm run \"/^fix:.*/\"",
    "fix:eslint": "eslint --fix .",
    "fix:prettier": "prettier --write \"**/*.{json,jsonc,yml,js,mjs,ts,vue}\" --experimental-cli",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:eslint": "eslint .",
    "lint:typecheck": "nuxt typecheck",
    "lint:prettier": "prettier -l \"**/*.{json,jsonc,yml,js,mjs,ts,vue}\" --experimental-cli",
    "prepare": "husky && nuxt prepare",
    "test": "vitest run"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": [
      "eslint --fix",
      "prettier --write --experimental-cli"
    ],
    "*.{json,jsonc,yml}": "prettier --write --experimental-cli"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@nuxt/content": "^3.15.2",
    "@nuxt/ui": "^4.10.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/i18n": "^10.6.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "remark-custom-heading-id": "^2.0.0",
    "vue": "^3.5.41",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@testing-library/vue": "^8.1.0",
    "@types/js-beautify": "^1.14.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.123.0"
  }
}
