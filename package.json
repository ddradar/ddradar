{
  "name": "ddradar",
  "version": "3.0.0",
  "private": true,
  "description": "DDR Score Tracker",
  "license": "MIT",
  "author": "Nogic <24802730+nogic1008@users.noreply.github.com>",
  "repository": "https://github.com/ddradar/ddradar.git",
  "type": "module",
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' nuxt build",
    "db:generate": "nuxt db generate",
    "db:query": "wrangler d1 execute DB",
    "dev": "nuxt dev",
    "fix": "pnpm run \"/^fix:.*/\"",
    "fix:eslint": "eslint --fix .",
    "fix:oxfmt": "oxfmt",
    "fix:oxlint": "oxlint --fix .",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:eslint": "eslint .",
    "lint:oxfmt": "oxfmt --check",
    "lint:oxlint": "oxlint .",
    "lint:typecheck": "nuxt typecheck",
    "prepare": "husky && nuxt prepare",
    "test": "vitest run"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@nuxt/content": "^3.16.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/i18n": "^10.6.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^3.3.18",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "remark-custom-heading-id": "^2.0.0",
    "ufo": "^1.6.4",
    "vue": "^3.5.42",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.1",
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/simple-icons": "^1.2.94",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.2.0",
    "@testing-library/vue": "^8.1.0",
    "@types/js-beautify": "^1.14.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-plugin-oxlint": "^1.80.0",
    "h3": "^1.15.11",
    "happy-dom": "^20.11.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.3",
    "unstorage": "^1.17.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.127.0"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": [
      "oxlint --fix",
      "eslint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,yaml,yml}": "oxfmt"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@11.24.0"
}
